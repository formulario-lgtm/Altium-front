{
  "components": {
    "schemas": {
      "CursorPageInfoDto": {
        "properties": {
          "hasNextPage": {
            "example": false,
            "type": "boolean"
          },
          "limit": {
            "example": 25,
            "minimum": 1,
            "type": "number"
          },
          "nextCursor": {
            "description": "Opaque cursor for the next page, or null when exhausted",
            "example": null,
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "limit",
          "hasNextPage"
        ],
        "type": "object"
      },
      "FieldErrorDto": {
        "properties": {
          "code": {
            "example": "INVALID_EMAIL",
            "type": "string"
          },
          "field": {
            "example": "email",
            "type": "string"
          },
          "message": {
            "example": "Invalid email format",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "OffsetPageInfoDto": {
        "properties": {
          "hasNextPage": {
            "example": false,
            "type": "boolean"
          },
          "limit": {
            "example": 25,
            "minimum": 1,
            "type": "number"
          },
          "offset": {
            "example": 0,
            "minimum": 0,
            "type": "number"
          },
          "total": {
            "description": "Total matching rows when inexpensive to compute",
            "example": 100,
            "type": "number"
          }
        },
        "required": [
          "limit",
          "offset",
          "total",
          "hasNextPage"
        ],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "detail": {
            "example": "One or more fields are invalid",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            },
            "type": "array"
          },
          "instance": {
            "example": "/api/v1/customers",
            "type": "string"
          },
          "requestId": {
            "example": "req_01HXYZ",
            "type": "string"
          },
          "status": {
            "example": 400,
            "type": "number"
          },
          "title": {
            "example": "Validation failed",
            "type": "string"
          },
          "type": {
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "REST contract for the Altium CRM backend. Successful responses return the resource JSON directly (or `{ items, pageInfo }` for collections). Errors use Problem Details (`application/problem+json`) per RFC 9457. Business CRM endpoints are not implemented in this bootstrap stage.",
    "title": "Altium CRM API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Unversioned technical probe. Returns a minimal payload with no sensitive details.",
        "operationId": "Health_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "example": "ok",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Service is healthy"
          }
        },
        "summary": "Application health check",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Relative to the API host",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Technical liveness probes (unversioned)",
      "name": "health"
    },
    {
      "description": "Shared schemas used across modules",
      "name": "common"
    }
  ]
}
